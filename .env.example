# Copy to .env for local dev (the server does not load .env itself; use `node --env-file=.env` or export the variables).
# Interface to listen on. 0.0.0.0 inside Docker; 127.0.0.1 if only a local cloudflared should reach it.
HOST=0.0.0.0
PORT=3000
DATA_DIR=./data
# Exact Host header the app accepts. In dev via the Vite proxy use localhost:5173
ALLOWED_HOST=waypoint.yaxley.com.au
# true in production (browser always sees HTTPS via Cloudflare)
COOKIE_SECURE=true
# true only when the origin is private behind the tunnel
TRUST_CLOUDFLARE_HEADERS=false
# 32 random bytes, base64. Generate: openssl rand -base64 32
# Losing it makes stored Canvas/Claude keys unreadable.
ENCRYPTION_KEY=
# First admin, created on first start if no admin exists. Must be changed at first sign-in.
ADMIN_USERNAME=
ADMIN_PASSWORD=
